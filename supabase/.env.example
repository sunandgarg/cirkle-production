# Supabase Auth Send SMS HTTP Hook
FAST2SMS_API_KEY="your-fast2sms-api-key"
FAST2SMS_OTP_ID="9318bdac9f"
SEND_SMS_HOOK_SECRET="v1,whsec_your-base64-secret"

# Amazon SES direct transactional email
AWS_ACCESS_KEY_ID="your-iam-access-key-id"
AWS_SECRET_ACCESS_KEY="your-iam-secret-access-key"
# Only set this for temporary AWS credentials.
AWS_SESSION_TOKEN=""
AWS_REGION="ap-south-1"
AWS_SES_FROM_EMAIL="Cirkle <verify@your-verified-domain.example>"

# Application Edge Functions
VERIFICATION_CODE_SECRET="a-long-random-secret"
ALLOWED_ORIGINS="https://your-production-domain.example"

# Local/staging only. Never enable this in production: it accepts email OTP 123456.
EMAIL_OTP_TEST_MODE="false"
