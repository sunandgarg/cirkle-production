# Values prefixed with VITE_ are public and are bundled into browser code.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"

# Local/staging only. Never enable this on a production deployment.
# It bypasses SMS/email delivery and accepts OTP 123456 in the browser.
VITE_ENABLE_TEST_OTP="false"

# Never put sb_secret_*, service-role, SMS, or email-provider keys in this file.
